    "@earendil-works/pi-tui": "1.4.0",
    "@oxlint/plugins": "1.89.0",
    "@types/node": "^26.6.5",
    "@types/turndown": "^5.0.6",
    "jiti": "2.7.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typebox": "^1.4.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "effect": "4.0.6",
    "htmlparser2": "^12.0.0",
    "turndown": "^7.2.4"
