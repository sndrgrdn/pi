    "test": "vitest run --exclude 'agent/git/**' --exclude 'agent/npm/**' --exclude 'agent/sessions/**'"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
