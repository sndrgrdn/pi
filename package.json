    "@earendil-works/pi-tui": "0.85.1",
    "@oxlint/plugins": "1.82.0",
    "@types/node": "^26.5.1",
    "@types/turndown": "^5.0.6",
    "jiti": "2.7.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "typebox": "^1.3.30",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "dependencies": {
