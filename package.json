{
  "name": "pi",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "oxfmt --check \"agent/**/*.ts\" && oxlint --deny-warnings . && tsc --noEmit",
    "fix": "oxfmt --write \"agent/**/*.ts\" && oxlint --fix .",
