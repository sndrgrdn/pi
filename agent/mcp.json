{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "pnpx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "pnpx",
      "args": [
        "chrome-devtools-mcp@latest",
        "--browserUrl=http://127.0.0.1:9222"
      ]
    },
    "homeassistant": {
      "type": "http",
      "url": "http://homeassistant.local:9583/private_L6cMaK8XnXnfqNMAX8IGeQ"
    },
    "rea": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "rea-agents@6.7.0",
        "mcp"
      ],
      "env": {
        "HOPPER_LAUNCHER_PATH": "/Users/sander/Applications/Hopper Disassembler.app/Contents/MacOS/hopper",
        "REA_JADX_MCP_JAR": "/Users/sander/.local/share/rea/android/jadx-headless-mcp-0.7.1-all.jar",
        "JAVA_HOME": "/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home"
      }
    }
  }
}
