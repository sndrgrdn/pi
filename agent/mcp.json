{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "pnpx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "pnpx",
      "args": [
        "chrome-devtools-mcp@latest",
        "--browserUrl=http://127.0.0.1:9222"
      ]
    },
    "homeassistant": {
      "type": "http",
      "url": "http://homeassistant.local:9583/private_L6cMaK8XnXnfqNMAX8IGeQ",
      "enabled": false
    },
    "computer": {
      "type": "stdio",
      "command": "cua-driver",
      "args": [
        "mcp"
      ],
      "timeout": 60
    }
  }
}
